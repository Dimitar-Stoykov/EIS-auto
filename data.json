{
  "model": "eisauto.servicepage",
  "pk": 2,
  "fields": {
    "service_type": "transport",
    "eyebrow": "",
    "hero_title": "",
    "hero_subtitle": "",
    "section_title": "",
    "description": "Когато автомобилът Ви аварира, всяка минута е от значение. ЕИС Ауто Сервиз вече предлага професионална услуга пътна помощ за леки автомобили на територията на област София, с възможност за обслужване в цялата страна при необходимост. Разполагаме с необходимата техника за безопасно транспортиране на автомобила до избрана от Вас локация или директно до нашия сервиз.\r\n\r\nНезависимо дали става въпрос за техническа повреда, пътнотранспортно произшествие или автомобил, който не може да продължи движението си, можете да разчитате на бърза реакция, коректно обслужване и сигурен транспорт за Вашия автомобил. Нашата цел е да Ви помогнем възможно най-бързо, за да се върнете спокойно на пътя.",
    "address_detail": "",
    "is_active": true,
    "order": 0
  }
},
{
  "model": "eisauto.servicepage",
  "pk": 3,
  "fields": {
    "service_type": "tires",
    "eyebrow": "",
    "hero_title": "",
    "hero_subtitle": "",
    "section_title": "",
    "description": "Професионален сервиз за гуми и джанти\r\n\r\nВ ЕиС Аутосървиз се грижим автомобилът ви да бъде сигурен и стабилен на пътя. Предлагаме пълно обслужване на гуми и джанти – смяна и баланс на гуми, ремонт при повреди и машинно изправяне на джанти със специализирана техника.\r\n\r\nПри нас можете да намерите и нови и употребявани гуми и джанти за различни автомобили и бюджети. Ще ви помогнем да изберете подходящия вариант според автомобила, начина ви на шофиране и нуждите ви.\r\n\r\nЗалагаме на прецизна работа, коректно отношение и бързо обслужване, защото добрият контакт с пътя започва от правилно поддържаните гуми и джанти.\r\n\r\nЕиС Аутосървиз – всичко необходимо за гумите и джантите на вашия автомобил на едно място.",
    "address_detail": "",
    "is_active": true,
    "order": 0
  }
