# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database — leave blank to keep using local sqlite (db.sqlite3).
# Fill in only when moving to a real Postgres/MySQL server.
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Email (contact form + admin password reset)
# — Production (Railway): fill in RESEND_* below instead. Railway blocks
#   outbound SMTP, so Gmail below won't work there anyway.
# — Local dev only, optional: fill these in if you want the contact form to
#   actually send while running on your own machine. Leave blank to just
#   print emails to the console instead (fine for local testing).
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Cloudflare R2 — leave all blank to keep using local staticfiles/mediafiles
# folders (normal local dev). Fill in only when deploying.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=

# Resend — this is what actually sends email in production (Railway).
# Takes priority over the Gmail settings above whenever it's filled in.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Recipient the contact form falls back to if SiteSettings.email (set via
# admin) is empty. Usually leave blank — SiteSettings.email is the real one.
DEFAULT_CONTACT_EMAIL=
