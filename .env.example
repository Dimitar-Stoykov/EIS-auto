# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database — leave blank to keep using local sqlite (db.sqlite3).
# Fill in only when moving to a real Postgres/MySQL server.
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Email (contact form + admin password reset)
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Cloudflare R2 — leave all blank to keep using local staticfiles/mediafiles
# folders (normal local dev). Fill in only when deploying.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=
