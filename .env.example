# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# Django
SECRET_KEY=change-me-to-a-long-random-string

# Email (contact form + admin password reset)
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
